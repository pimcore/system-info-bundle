parameters:
    level: 6
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
    	-
    	    dentifier: missingType.iterableValue
    	-
            identifier: missingType.generics
    paths:
        - src
    bootstrapFiles:
        - phpstan-bootstrap.php
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - phpstan-baseline.neon